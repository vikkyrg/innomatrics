# Careers form — Nodemailer via Gmail SMTP (used by api/careers.js on Vercel)
# Set these in Vercel: Project → Settings → Environment Variables
# (for Production, Preview, and Preview environments)

# The Gmail account that SENDS the application emails
GMAIL_USER=imtwebdevelopment@gmail.com

# A 16-character Gmail App Password (NOT the normal login password).
# Create one at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=your-16-char-app-password
